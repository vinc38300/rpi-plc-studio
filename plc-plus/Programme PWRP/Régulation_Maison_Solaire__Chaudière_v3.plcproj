            "w": 120,
            "x": -60,
            "y": 960
          },
          {
            "h": 100,
            "id": "P7_K5",
            "params": {
              "active_low": true,
              "name": "K5_Circ_ECS_Solaire",
              "pin": 22
            },
            "type": "OUTPUT",
            "w": 480,
            "x": 1040,
            "y": -60
          },
          {
            "h": 436,
            "id": "P7_ECS",
            "params": {
              "code": "# ============================================================\n# pyblock  : gestion_ecs\n# Projet   : Régulation maison solaire + chaudière\n# Auteur   : regulech — transposition Proview 25-NOV-2023\n#\n# Ports d'ENTRÉE :\n#   A1  = T_capteurs_sol  (ANA2)\n#   A2  = T_ballon_bas    (ANA5)\n#   A3  = hyst_bas        (AV.Hyst_Ballon_Bas)\n#   A4  = T_chaudiere     (ANA3)\n#   A5  = T_ballon_haut   (ANA4)\n#   A6  = hyst_haut       (AV.Hyst_Ballon_Haut)\n#   A7  = T_consigne      (AV.Conssigne_Ballons)\n#   A8  = T_ballon_mini   (AV.Conssigne_MINI_Ballons_S_CH)\n#   A9  = T_ballon_max    (AV.Conssigne_Ballons_Max)\n#   A10 = T_bouclage      (ANA8 — sonde bouclage)\n#   d1  = marche_ecs_sol  (DV_ECS_SOL)\n#   d2  = marche_ecs_ch   (DV_ECS_CH)\n#   d3  = prod_chaudiere  (TOR_IN_4)\n#   d4  = circ_plancher   (CIRC_PL_ON)\n#   d5  = bp_marche       (DV_MARCHE)\n#   d6  = forcage_circ_sol(DV_FCIRC_SOL)\n#   d7  = forcage_circ_ch (DV_FCIRC_CH)\n#\n# Ports de SORTIE :\n#   od1 = circ_ecs_solaire_on    → K5 (GPIO22)\n#   od2 = circ_ecs_chaudiere_on  → K6 (GPIO27)\n#   od3 = demande_mini_chaudiere\n#   od4 = demande_ecs_chaudiere\n#   od5 = solaire_actif\n#   od6 = ballon_plein (reset ECS)\n#   od7 = run_compteur_sol\n#   od8 = run_compteur_ch\n#   OA1 = T_consigne_corrigée (synoptique)\n# ============================================================\n\nT_cap_sol   = A1\nT_ball_bas  = A2\nhyst_bas    = A3\nT_chaud     = A4\nT_ball_haut = A5\nhyst_haut   = A6\nT_cons      = A7\nT_mini_bal  = A8\nT_ball_max  = A9    # Conssigne_Ballons_Max — plus de read_analog()\nT_bouclage  = A10   # ANA8 — plus de read_analog()\n\nmarche_sol  = d1\nmarche_ch   = d2\nprod_ch     = d3\ncirc_planch = d4\nbp_marche   = d5\nforcage_sol  = d6\nforcage_ch   = d7\nv3v_sol_on   = d8   # V3V_SOL_ON — position solaire\n\n# ── State ──────────────────────────────────────────────────────────────\nif \"sr_s6\"  not in state: state[\"sr_s6\"]  = False\nif \"sr_s7\"  not in state: state[\"sr_s7\"]  = False\nif \"t15\"    not in state: state[\"t15\"]    = 0.0\nif \"t16\"    not in state: state[\"t16\"]    = 0.0\nif \"w17\"    not in state: state[\"w17\"]    = 0.0\nif \"w18\"    not in state: state[\"w18\"]    = 0.0\nif \"w26\"    not in state: state[\"w26\"]    = 0.0\nif \"cpt_sol\"not in state: state[\"cpt_sol\"]= 0.0\nif \"cpt_ch\" not in state: state[\"cpt_ch\"] = 0.0\nif \"sr_ecs\" not in state: state[\"sr_ecs\"] = False\n\n# ── Sécurité ballon max ────────────────────────────────────────────────\nsecu_max_ok = T_ball_haut < T_ball_max   # A9 — plus de read_analog()\n\n# ── od1 : circulateur solaire ──────────────────────────────────────────\nod1_cond = T_cap_sol > (T_ball_bas + hyst_bas) and marche_sol and bp_marche\n\n# od5 : solaire actif\nod5 = ((T_cap_sol + hyst_bas) >= T_cons)\n\n# Consigne ballon haut corrigée\nOA1_corr = T_cons + hyst_haut\n\n# SR_S6 : ECS solaire (set/reset)\nif od1_cond:\n    state[\"w17\"] += dt\n    if state[\"w17\"] >= 5.0:\n        state[\"sr_s6\"] = True\nelse:\n    state[\"w17\"] = 0.0\n\n# Timer15 anti-court-cycle circulateur solaire\nif not od1_cond and state[\"sr_s6\"]:\n    state[\"t15\"] += dt\n    if state[\"t15\"] >= 15.0:\n        state[\"sr_s6\"] = False\n        state[\"t15\"] = 0.0\nelse:\n    state[\"t15\"] = 0.0\n\n# ── od2 : circulateur chaudière ECS ───────────────────────────────────\nod2_cond = (\n    (T_chaud > 60.0) and prod_ch\n    and (T_chaud > T_ball_haut) and marche_ch\n    and (not v3v_sol_on)   # pas de circ ECS chaud. si V3V en pos. solaire\n)\n\n# SR_S7 : ECS chaudière\nif od2_cond:\n    state[\"w26\"] += dt\n    if state[\"w26\"] >= 12.0:\n        state[\"sr_s7\"] = True\nelse:\n    state[\"w26\"] = 0.0\n\nif not od2_cond and state[\"sr_s7\"]:\n    state[\"t16\"] += dt\n    if state[\"t16\"] >= 15.0:\n        state[\"sr_s7\"] = False\n        state[\"t16\"] = 0.0\nelse:\n    state[\"t16\"] = 0.0\n\n# od3 : demande mini ballon → chaudière\nod3 = T_ball_bas <= T_mini_bal\n\n# od4 : demande ECS chaudière (set/reset)\nod6_set   = T_ball_haut < OA1_corr\nod7_reset = T_ball_haut >= T_cons\nif od6_set:   state[\"sr_ecs\"] = True\nif od7_reset: state[\"sr_ecs\"] = False\nod4 = state[\"sr_ecs\"]\n\n# od6 : ballon plein\nod6 = T_ball_haut >= T_cons\n\n# ── Forçages ────────────────────────────────────────────────────────────\nod1_fin = forcage_sol or (state[\"sr_s6\"] and secu_max_ok)\nod2_fin = forcage_ch  or (state[\"sr_s7\"] and secu_max_ok)\n\n# ── Sorties ────────────────────────────────────────────────────────────\nod1 = od1_fin\nod2 = od2_fin\nod7 = od1_fin\nod8 = od2_fin\nOA1 = OA1_corr\n\nif od7: state[\"cpt_sol\"] += dt\nif od8: state[\"cpt_ch\"]  += dt\n\nwrite_register(\"RF2\", float(od4))\nwrite_register(\"RF3\", float(od3))\nwrite_register(\"RF4\", float(od1))\n",
              "n_a": 10,
              "n_d": 8,
              "n_i": 0,
              "n_oa": 1,
              "n_od": 4,
              "n_oi": 0,
              "name": "gestion_ecs"
            },
            "type": "PYBLOCK",
            "w": 260,
            "x": 560,
            "y": 40
          },
