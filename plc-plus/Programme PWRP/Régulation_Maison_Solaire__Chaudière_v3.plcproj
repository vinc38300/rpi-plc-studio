            },
            "type": "AV",
            "w": 520,
            "x": -660,
            "y": 180
          },
          {
            "h": 480,
            "id": "P9_CH",
            "params": {
              "code": "# ============================================================\n# pyblock  : chaudiere\n# Projet   : Régulation maison solaire + chaudière\n# Auteur   : regulech — transposition Proview 25-NOV-2023\n# Remplace : CArit55, CArit91, XOr0/10, Inv12/14, Inv47-53,\n#            Timer0/1, Wait21/22/25/31-33, And31, Pulse3,\n#            SR_S8/9/10, RunTimeCntFo227M\n#\n# Ports d'ENTRÉE :\n#   A1 = T_chaudiere           (ANA3 + CTN_4)\n#   A2 = T_ballon_haut         (ANA4 + CTN_5 — Ballon_Haut1)\n#   A3 = T_retour_plancher     (ANA7 + CTN_8 — Retour_Froid_Planché)\n#   A4 = T_consigne_depart     (← RF5 de loi_eau)\n#   A5 = T_marche_chaudiere    (AV.Cons_Temp_de_Marche_Chaudière)\n#   A6 = T_degommage           (AV.Cons_temp_de_marche_Degommage)\n#   A7 = T_marche_circulateur  (AV.Cons_temp_de_marche_Circulateur)\n#   A8 = T_consigne_ballons    (AV.Conssigne_Ballons)\n#   d1 = demande_ecs           (← RF2 de gestion_ecs = od4)\n#   d2 = demande_mini_ecs      (← RF3 de gestion_ecs = od3)\n#   d3 = demande_plancher      (← RF7 de loi_eau = od4)\n#   d4 = prod_chaudiere        (TOR_IN_4 Contact_Production)\n#   d5 = alarme_chaudiere      (TOR_IN_1 Contact_Alarme)\n#   d6 = circ_plancher         (← RF6 de loi_eau)\n#   d7 = circ_ecs_ch           (← RF4 de gestion_ecs)\n#   d8 = v3v_solaire_pos       (← RF1 de solaire_thermique)\n#   d9  = arret_force          (DV.Arret_Chaudiere)\n#   d10 = forcage_arret_auto   (DV.BP_Forcage_Arret_Auto_Chaudiere)\n#   d11 = forcage_rehausse     (DV.Forcage_circulateur_réausse)\n#   d12 = marche_chauffage     (DV.BP_Marche_Arret_Chauffage)\n#\n# Ports de SORTIE :\n#   od1 = autorisation_chaudiere → K1 (GPIO5)\n#   od2 = circ_rehausse_on       → K4 (GPIO10)\n#   od3 = run_compteur_marche\n#   OA1 = T_chaud_plus5 (synoptique)\n# ============================================================\n\nT_chaud    = A1\nT_ball_h   = A2\nT_ret_pl   = A3\nT_cons_dep = A4\nT_marche   = A5\nT_degom    = A6\nT_marche_c = A7\nT_cons_bal = A8   # Conssigne_Ballons\n\ndem_ecs    = d1\ndem_mini   = d2\ndem_planch = d3\nprod_ch    = d4\nalarme     = d5\ncirc_pl    = d6\ncirc_ecs   = d7\nv3v_sol    = d8\narret_force      = d9   # Arret_Chaudiere\nforcage_arret    = d10  # BP_Forcage_Arret_Auto_Chaudiere\nforcage_rehausse = d11  # Forcage_circulateur_réausse\nmarche_chauffage = d12  # BP_Marche_Arret_Chauffage\n\n# ── State ──────────────────────────────────────────────────────────────\nif \"sr_s8\"  not in state: state[\"sr_s8\"]  = False\nif \"sr_s9\"  not in state: state[\"sr_s9\"]  = False\nif \"sr_s10\" not in state: state[\"sr_s10\"] = False\nif \"t0\"     not in state: state[\"t0\"]     = 0.0\nif \"t1\"     not in state: state[\"t1\"]     = 0.0\nif \"w21\"    not in state: state[\"w21\"]    = 0.0\nif \"w25\"    not in state: state[\"w25\"]    = 0.0\nif \"w31\"    not in state: state[\"w31\"]    = 0.0\nif \"pulse3\" not in state: state[\"pulse3\"] = 0.0\nif \"cpt\"    not in state: state[\"cpt\"]    = 0.0\nif \"last_day\" not in state: state[\"last_day\"] = -1\n\n# ── Validité T° chaudière ──────────────────────────────────────────────\nT_valid = (0.0 < T_chaud < 110.0)\n\n# ── CArit55 — routage demandes ─────────────────────────────────────────\nauto_ecs    = T_valid and dem_ecs\nauto_planch = T_valid and dem_planch and (not v3v_sol)\n\n# SR_S8 : autorisation ECS\nif auto_ecs:            state[\"sr_s8\"] = True\nif not dem_ecs:         state[\"sr_s8\"] = False\n\n# SR_S9 : autorisation plancher\nif auto_planch:         state[\"sr_s9\"] = True\nif not dem_planch:      state[\"sr_s9\"] = False\n\n# SR_S10 : autorisation mini ballon\nif dem_mini:            state[\"sr_s10\"] = True\nif T_ball_h >= T_cons_bal: state[\"sr_s10\"] = False   # A8 — plus de read_analog()\n\n# ── CArit91 — réhausse + contrôle T° ──────────────────────────────────\nOA1_plus5 = T_chaud + 5.0\nT_cible   = max(T_cons_dep, T_ball_h)\n\nod2_ctrl = (OA1_plus5 >= T_cible) and (OA1_plus5 > 65.0)\n\nauto_ch = state[\"sr_s8\"] or state[\"sr_s9\"] or state[\"sr_s10\"]\nod1_reh = od2_ctrl and (not prod_ch) and (not forcage_arret) and auto_ch           and (circ_pl or circ_ecs)\n\nod3_on = (circ_pl or circ_ecs) or marche_chauffage\n\n# ── Anti-gommage annuel (30 janv, 3 s) ────────────────────────────────\nnow = datetime.datetime.now()\nif now.month == 1 and now.day == 30 and state[\"last_day\"] != 30:\n    state[\"last_day\"] = 30\n    state[\"pulse3\"]   = 3.0\n\nif state[\"pulse3\"] > 0:\n    state[\"pulse3\"] -= dt\n    auto_ch = True\n\n# ── XOr0 : bascule auto / arret forcé ─────────────────────────────────\nif arret_force:\n    auto_ch = False\n    state[\"sr_s8\"] = state[\"sr_s9\"] = state[\"sr_s10\"] = False\n\n# ── Délai Wait21=5s avant circulateur réhausse ────────────────────────\nif od1_reh or forcage_rehausse:\n    state[\"w21\"] += dt\nelse:\n    state[\"w21\"] = 0.0\n\ncirc_reh_ok = (state[\"w21\"] >= 5.0) or forcage_rehausse\n\n# ── Autorisation chaudière finale ─────────────────────────────────────\nauto_final = auto_ch and (not alarme) and (not arret_force) and od3_on\n\nod1 = auto_final\nod2 = forcage_rehausse or (circ_reh_ok and auto_final)\nod3 = od1\nif od3: state[\"cpt\"] += dt\n\nOA1 = OA1_plus5\n\nwrite_register(\"RF9\",  float(od1))\nwrite_register(\"RF10\", float(od2))\n",
              "n_a": 8,
              "n_d": 12,
              "n_i": 0,
              "n_oa": 1,
              "n_od": 3,
              "n_oi": 0,
              "name": "chaudiere",
              "od3_ref": "RUN_CPT_CH"
            },
