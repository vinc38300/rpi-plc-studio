            "y": 360
          },
          {
            "h": 392,
            "id": "P8_LOI",
            "params": {
              "code": "# ============================================================\n# pyblock  : loi_eau  (Plancher Chauffant)\n# Projet   : Régulation maison solaire + chaudière\n# Auteur   : regulech — transposition Proview 25-NOV-2023\n# Remplace : CArit75, CArit232, Mux77, Timer11/12/21/22,\n#            Wait×6, XOr3/8/9, Inv30/31, SR_R13/14, K7K8/K9\n#\n# Ports d'ENTRÉE :\n#   A1=T_ext  A2=T_amb  A3=T_dep  A4=T_cons_amb\n#   A5=corr_jn  A6=corr_dep_sol  A7=T_dep_max\n#   d1=v3v_sol_pos  d2=marche_ch   d3=marche_sol\n#   d4=confort      d5=forcage_circ d6=forcage_close\n#   d7=forcage_open d8=arret_v3v\n#\n# Registres RF partagés (pas de collision) :\n#   RF5=csg_dep  RF6=circ  RF7=dem_ch  RF8=surchauffe\n#   RF12=position V3V 0-100% pour synoptique\n# ============================================================\n\nT_ext        = A1;  T_amb  = A2;  T_dep = A3;  T_cons_amb = A4\ncorr_jn      = A5;  corr_dep_sol = A6;  T_dep_max = A7\nv3v_sol_pos  = d1;  marche_ch = d2;  marche_sol = d3;  confort = d4\nforcage_circ = d5;  forcage_close = d6;  forcage_open = d7;  arret_v3v = d8\n\n# ── State (init unique) ─────────────────────────────────────\nif \"t7\"       not in state: state[\"t7\"]       = 0.0\nif \"t_gom\"    not in state: state[\"t_gom\"]    = 0.0\nif \"v3v_pos\"  not in state: state[\"v3v_pos\"]  = 0.0\nif \"_cmd_ouv\" not in state: state[\"_cmd_ouv\"] = False\nif \"_cmd_fer\" not in state: state[\"_cmd_fer\"] = False\n\nbp_marche_general = read_signal(\"BP_Marche\")\n\nif not bp_marche_general:\n    # ── Arrêt général — tout OFF ────────────────────────────\n    od1 = od2 = od3 = od4 = od5 = False\n    OA1 = OA2 = OA3 = 0.0\n    state[\"_cmd_ouv\"] = False\n    state[\"_cmd_fer\"] = False\n    write_register(\"RF5\",  0.0);  write_register(\"RF6\",  0.0)\n    write_register(\"RF7\",  0.0);  write_register(\"RF8\",  0.0)\n    write_register(\"RF12\", state[\"v3v_pos\"])\n\nelse:\n    # ── CArit75 — Loi d'eau ────────────────────────────────\n    OA1 = min(0.6 * (T_cons_amb - T_ext) + T_cons_amb, T_dep_max)\n    OA2 = OA1 + corr_dep_sol if v3v_sol_pos else OA1\n    OA3 = T_cons_amb + corr_jn if confort else T_cons_amb\n\n    demande_chauff  = T_amb < OA3\n    consigne_active = OA2 if v3v_sol_pos else OA1\n\n    # ── Surchauffe départ ───────────────────────────────────\n    od5 = T_dep > (consigne_active + 0.5)\n\n    # ── Circulateurs ────────────────────────────────────────\n    circ_ch  = (not v3v_sol_pos) and marche_ch  and demande_chauff\n    circ_sol = v3v_sol_pos and marche_sol and marche_ch and demande_chauff and (not od5)\n    od1      = circ_ch or circ_sol or forcage_circ\n\n    # ── V3V flottant 3 points — intégrateur de position ─────\n    # Course mesurée : 133 s (2 min 13 s) pour 0 % → 100 %\n    # Zone morte 1.5 % → supprime le micro-papillonnage moteur\n    TRAVEL_TIME = 133.0   # s\n    V3V_DB      = 1.5     # %\n\n    # Intégrer la position depuis les commandes du scan précédent\n    if   state[\"_cmd_ouv\"]: state[\"v3v_pos\"] = min(100.0, state[\"v3v_pos\"] + (dt / TRAVEL_TIME) * 100.0)\n    elif state[\"_cmd_fer\"]: state[\"v3v_pos\"] = max(0.0,   state[\"v3v_pos\"] - (dt / TRAVEL_TIME) * 100.0)\n\n    # Consigne de position (gain 20 %/°C, paramétrable via AV \"Kv3v\")\n    kv3v_av   = float(read_analog(\"Kv3v\"))\n    kv3v      = kv3v_av if kv3v_av != 0.0 else 20.0\n    target_pos = max(0.0, min(100.0, (consigne_active - T_dep) * kv3v))\n    if od5: target_pos = 0.0   # surchauffe → fermer\n\n    # Commandes moteur 3 points\n    if not arret_v3v:\n        if   forcage_open  and not od5:                    cmd_ouv = True;  cmd_fer = False\n        elif forcage_close:                                cmd_ouv = False; cmd_fer = True\n        elif target_pos > state[\"v3v_pos\"] + V3V_DB:      cmd_ouv = True;  cmd_fer = False\n        elif target_pos < state[\"v3v_pos\"] - V3V_DB:      cmd_ouv = False; cmd_fer = True\n        else:                                              cmd_ouv = False; cmd_fer = False\n    else:\n        cmd_ouv = False; cmd_fer = False\n\n    state[\"_cmd_ouv\"] = cmd_ouv;  state[\"_cmd_fer\"] = cmd_fer\n    od2 = cmd_ouv   # K7 V3V_OUV\n    od3 = cmd_fer   # K8 V3V_FER\n\n    # ── Anti-gommage toutes les 30 min (6 s aller-retour) ───\n    state[\"t7\"] += dt\n    if state[\"t7\"] >= 1800.0:\n        state[\"t7\"] = 0.0;  state[\"t_gom\"] = 6.0\n\n    if state[\"t_gom\"] > 0:\n        state[\"t_gom\"] -= dt\n        od1 = True\n        if not arret_v3v:\n            if   state[\"t_gom\"] > 4.0: pass            # 0→2 s circ seul\n            elif state[\"t_gom\"] > 2.0: od2 = True;  od3 = False  # 2→4 s ouvrir\n            else:                      od2 = False; od3 = True    # 4→6 s fermer\n\n    # ── Demande chaudière plancher ───────────────────────────\n    od4 = demande_chauff and marche_ch and (not v3v_sol_pos)\n\n    # ── Registres partagés ───────────────────────────────────\n    write_register(\"RF5\",  OA1)\n    write_register(\"RF6\",  float(od1))\n    write_register(\"RF7\",  float(od4))\n    write_register(\"RF8\",  float(od5))\n    write_register(\"RF12\", state[\"v3v_pos\"])\n",
              "n_a": 8,
              "n_d": 8,
              "n_i": 0,
              "n_oa": 1,
              "n_od": 4,
              "n_oi": 0,
              "name": "loi_eau"
            },
            "type": "PYBLOCK",
            "w": 180,
            "x": 480,
            "y": 60
          }
        ],
        "id": "P8",
